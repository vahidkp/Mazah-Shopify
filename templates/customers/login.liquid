<div class="page-shell" style="max-width:28rem">
  <h1>Login</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <input type="email" name="customer[email]" placeholder="Email" class="checkout-input" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px" required>
    {%- if form.password_needed -%}
      <input type="password" name="customer[password]" placeholder="Password" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px" required>
      <a href="#recover" class="muted" style="font-size:.875rem">Forgot your password?</a>
    {%- endif -%}
    <button type="submit" class="btn btn--solid btn--lg" style="width:100%;margin-top:16px">Sign In</button>
  {%- endform -%}
  <p class="muted" style="font-size:.875rem;margin-top:16px">New here? <a href="{{ routes.account_register_url }}" style="text-decoration:underline">Create an account</a></p>

  <div id="recover" style="margin-top:32px">
    {%- form 'recover_customer_password' -%}
      {{ form.errors | default_errors }}
      {%- if form.posted_successfully? -%}<p class="muted">We've sent you an email to reset your password.</p>{%- endif -%}
      <p class="eyebrow" style="margin-bottom:8px">Reset password</p>
      <input type="email" name="email" placeholder="Email" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px" required>
      <button type="submit" class="btn btn--outline">Send reset link</button>
    {%- endform -%}
  </div>
</div>
