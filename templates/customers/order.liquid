<div class="page-shell">
  <h1>Order {{ order.name }}</h1>
  <p class="muted">Placed {{ order.created_at | date: '%B %-d, %Y' }}</p>
  <table style="width:100%;border-collapse:collapse;font-size:.875rem;margin-top:24px">
    <thead><tr style="text-align:left;border-bottom:1px solid var(--line)"><th style="padding:8px 0">Product</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr style="border-bottom:1px solid var(--line)"><td style="padding:8px 0">{{ line.title }}</td><td>{{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td></tr>
      {%- endfor -%}
    </tbody>
  </table>
  <div style="margin-top:16px;text-align:right">
    <p>Subtotal: {{ order.line_items_subtotal_price | money }}</p>
    <p>Shipping: {{ order.shipping_price | money }}</p>
    <p style="font-weight:700">Total: {{ order.total_price | money }}</p>
  </div>
</div>
