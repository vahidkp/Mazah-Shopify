<div class="page-shell" style="max-width:28rem">
  <h1>Create account</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="First name" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px">
    <input type="text" name="customer[last_name]" placeholder="Last name" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px">
    <input type="email" name="customer[email]" placeholder="Email" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px" required>
    <input type="password" name="customer[password]" placeholder="Password" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:12px" required>
    <button type="submit" class="btn btn--solid btn--lg" style="width:100%;margin-top:16px">Create</button>
  {%- endform -%}
  <p class="muted" style="font-size:.875rem;margin-top:16px">Already have an account? <a href="{{ routes.account_login_url }}" style="text-decoration:underline">Log in</a></p>
</div>
