<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} Gift Card</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body style="background:var(--canvas)">
  <main style="max-width:32rem;margin:0 auto;padding:48px 24px;text-align:center">
    <p class="footer-wordmark" style="margin-bottom:16px">{{ shop.name }}</p>
    <h1 style="font-family:var(--font-display);font-size:1.5rem;font-weight:700">Your gift card</h1>
    <p style="font-family:var(--font-display);font-size:2.5rem;font-weight:800;margin:16px 0">{{ gift_card.balance | money }}</p>
    <div style="background:#fff;border:1px solid var(--line);border-radius:var(--radius-card);padding:24px;margin-top:16px">
      {{ gift_card.qr_identifier }}
      <p style="font-family:monospace;letter-spacing:.1em;margin-top:12px">{{ gift_card.code | format_code }}</p>
    </div>
  </main>
</body>
</html>
