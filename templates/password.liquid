<h1 style="font-family:var(--font-display);font-size:2rem;font-weight:800;letter-spacing:-.04em">Opening soon</h1>
<p class="muted" style="margin:12px 0 24px">{{ shop.password_message | default: 'Be the first to know when we launch.' }}</p>

{%- form 'storefront_password' -%}
  {%- if form.errors -%}
    <p style="color:var(--coral);font-size:.875rem;margin-bottom:12px">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
  {%- endif -%}
  <div style="display:flex;max-width:24rem;margin:0 auto">
    <input type="password" name="password" placeholder="Password" aria-label="Password" style="flex:1;border:1px solid var(--line);border-right:0;border-radius:999px 0 0 999px;padding:12px 16px;outline:none">
    <button type="submit" class="btn-solid" style="border-radius:0 999px 999px 0">Enter</button>
  </div>
{%- endform -%}

<p class="muted" style="font-size:.75rem;margin-top:24px">Are you the store owner? <a href="/admin" style="text-decoration:underline">Log in here</a></p>
