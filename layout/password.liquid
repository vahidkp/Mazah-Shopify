<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- assign font_display = settings.font_display -%}
    {%- assign font_body = settings.font_body -%}
    <style>
      {{ font_display | font_face: font_display: 'swap' }}
      {{ font_body | font_face: font_display: 'swap' }}
      :root {
        --ink: {{ settings.color_ink }}; --paper: {{ settings.color_paper }};
        --canvas: {{ settings.color_canvas }}; --card: {{ settings.color_card }};
        --line: {{ settings.color_line }}; --muted: {{ settings.color_muted }};
        --coral: {{ settings.color_coral }};
        --font-display-stack: {{ font_display.family }}, {{ font_display.fallback_families }};
        --font-body-stack: {{ font_body.family }}, {{ font_body.fallback_families }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="background:var(--canvas)">
    <main style="min-height:100vh;display:grid;place-items:center;padding:48px 24px;text-align:center">
      <div style="max-width:32rem">
        <p class="footer-wordmark" style="margin-bottom:24px">{{ settings.brand_name | default: 'mazah' }}</p>
        {{ content_for_layout }}
      </div>
    </main>
  </body>
</html>
