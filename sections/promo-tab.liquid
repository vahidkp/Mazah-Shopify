{%- comment -%} Dismissible floating promo pill {%- endcomment -%}
{%- if section.settings.enabled -%}
  <div class="promo-tab">
    <a href="{{ section.settings.url }}">{{ section.settings.text | default: '🏷️ Get up to 30% OFF' }}</a>
    <button type="button" data-promo-dismiss aria-label="Dismiss">{% render 'icon', name: 'close', size: 14 %}</button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Promo tab",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "🏷️ Get up to 30% OFF" },
    { "type": "url", "id": "url", "label": "Link" }
  ]
}
{% endschema %}
