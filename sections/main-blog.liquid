{%- comment -%} Blog listing {%- endcomment -%}
<div class="page-shell">
  <h1>{{ blog.title }}</h1>
  <div class="plp-grid" style="margin-top:24px">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="dk-sample" style="flex-direction:column;align-items:stretch;padding:0;overflow:hidden">
        {%- if article.image -%}
          <div style="position:relative;aspect-ratio:3/2;background:var(--card)">{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover' }}</div>
        {%- endif -%}
        <div style="padding:16px">
          <p class="dk-sample__name" style="white-space:normal">{{ article.title }}</p>
          <p class="muted" style="font-size:.75rem;margin-top:4px">{{ article.published_at | date: '%B %-d, %Y' }}</p>
          <p class="muted" style="font-size:.875rem;margin-top:8px">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
  {%- paginate blog.articles by 12 -%}
    {%- if paginate.pages > 1 -%}<div style="margin-top:32px;text-align:center">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
