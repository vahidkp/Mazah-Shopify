{%- comment -%} Split banner: copy + image (boutique / promo) {%- endcomment -%}
<section class="container-wide boutique reveal">
  <div class="boutique__inner">
    <div class="boutique__copy">
      <p class="boutique__title">{{ section.settings.heading }}</p>
      <p class="boutique__sub">{{ section.settings.subtext }}</p>
      {%- if section.settings.cta_label != blank -%}
        <div style="margin-top:20px">
          <a href="{{ section.settings.cta_url }}" class="btn btn--solid btn--md">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}
    </div>
    <div class="boutique__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading | strip_html, sizes: '(max-width:640px) 100vw, 40vw' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boutique banner",
  "settings": [
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Visit our boutiques for the perfect <strong>Father&rsquo;s Day pairing.</strong></p>" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Free gift with your purchase. IRL only. Ends June 21st!" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Find a Boutique" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [ { "name": "Boutique banner" } ]
}
{% endschema %}
