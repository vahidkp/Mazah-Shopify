[
  {
    "name": "theme_info",
    "theme_name": "Mazah",
    "theme_version": "1.0.0",
    "theme_author": "Mazah Perfume",
    "theme_documentation_url": "https://mazah.com",
    "theme_support_url": "https://mazah.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name (wordmark)",
        "default": "mazah",
        "info": "Rendered lowercase as the logo wordmark."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image (optional)",
        "info": "If set, replaces the text wordmark."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Core palette" },
      { "type": "color", "id": "color_ink", "label": "Ink (near-black text)", "default": "#141414" },
      { "type": "color", "id": "color_paper", "label": "Paper (white)", "default": "#FFFFFF" },
      { "type": "color", "id": "color_canvas", "label": "Canvas (warm white bg)", "default": "#FBFAF8" },
      { "type": "color", "id": "color_card", "label": "Card surface", "default": "#F4F1EC" },
      { "type": "color", "id": "color_line", "label": "Hairline border", "default": "#E9E5DF" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#6E6A63" },
      { "type": "color", "id": "color_faint", "label": "Faint text", "default": "#9C978E" },
      { "type": "header", "content": "Accents" },
      { "type": "color", "id": "color_coral", "label": "Coral (accent / member price)", "default": "#D6492E" },
      { "type": "color", "id": "color_gold", "label": "Gold", "default": "#C8962A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "Display font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Membership (Mazah+)",
    "settings": [
      {
        "type": "range",
        "id": "member_discount",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "%",
        "label": "Member discount",
        "default": 10,
        "info": "Used to derive the member price shown beneath the guest price."
      },
      {
        "type": "range",
        "id": "free_ship_threshold",
        "min": 0,
        "max": 250,
        "step": 5,
        "unit": "$",
        "label": "Free-shipping threshold",
        "default": 100
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  }
]
