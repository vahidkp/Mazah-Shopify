{%- comment -%} Mazah+ "Buy & save" members tier card for the PLP grid {%- endcomment -%}
<div class="promo-members">
  <p class="promo-members__eyebrow"><span class="brand">{{ settings.brand_name | default: 'mazah' }}+</span> Members Only</p>
  <p class="promo-members__title">Buy &amp; <span>save</span></p>
  <ul>
    <li><span>Buy 1, 2 items</span><span>10% OFF</span></li>
    <li><span>Buy 3 items</span><span>20% OFF</span></li>
    <li><span>Buy 4 items</span><span>25% OFF</span></li>
    <li><span>Buy 5+ items</span><span>30% OFF + FREE PERFUME</span></li>
